#! /usr/bin/env bash
# Author:
#   Aaron Kuehler
#
# Purpose:
#   Install the dotfiles
#

set -euo pipefail

DOTFILES_HOME="$HOME/.files"
PLATFORM="$(uname)"

# Omarchy (Arch + Hyprland) has its own installer under omarchy/, which drives
# Omarchy's package helpers and stows the Linux-relevant packages itself.
function is_omarchy() {
    [ "$PLATFORM" == "Linux" ] && [ -x "$(command -v omarchy-pkg-add)" ]
}

function ensure_package_manager() {
    if [ "$PLATFORM" == "Darwin" ] && ! [ -x "$(command -v brew)" ]
    then
        echo "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

        HOST_ARCHITECTURE="$(uname -m)"
        if [[ ${HOST_ARCHITECTURE} == *"x86" ]]
        then
            eval "$(/usr/local/bin/brew shellenv)"
        elif [[ ${HOST_ARCHITECTURE} == *"arm"* ]]
        then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi

        brew update
    elif [ "$PLATFORM" == "Linux" ] && [ -x "$(command -v apt)" ]
    then
        sudo apt update
    fi
}

function ensure_macos_package() {
    local package
    package="$1"

    if ! command -v "$package" &> /dev/null
    then
        brew install "$package"
    fi
}

function ensure_apt_package() {
    local package
    package="$1"

    if ! command -v "$package" &> /dev/null
    then
    sudo apt install -y "$package"
    fi
}

function ensure_macos_dependencies() {
    ensure_macos_package "stow"
    ensure_macos_package "git"
}

function ensure_linux_dependencies() {
    ensure_apt_package "stow"
    ensure_apt_package "git"
}

function ensure_dependencies() {
    if [ "$PLATFORM" == "Darwin" ]
    then
    ensure_macos_dependencies
    elif [ "$PLATFORM" == "Linux" ]
    then
    ensure_linux_dependencies
    fi
}

function ensure_local_dotfiles() {
    if ! [ -d "$DOTFILES_HOME" ]
    then
       git clone git@github.com:indiebrain/.files.git "$DOTFILES_HOME"
    fi
}

function place_configuration() {
    pushd "$DOTFILES_HOME" || { echo "Failed to change working directory to '$DOTFILES_HOME'. Aborting"; exit 1; }
    stow --verbose \
        asdf \
        bash \
        btop \
        emacs \
        firefox \
        ghostty \
        git \
        gnome-terminal \
        herdr \
        iterm2 \
        k9s \
        proselint \
        ripgrep \
        ruby \
        scripts \
        ssh

    # The ollama package carries a macOS LaunchAgent. Other platforms have no
    # launchd to read it, so it is placed only on Darwin.
    if [ "$PLATFORM" == "Darwin" ]
    then
        stow --verbose ollama
    fi
    popd || return
}

function secure_ssh_permissions() {
    # Directory permissions are not tracked by git/stow, so enforce the
    # owner-only mode OpenSSH expects on every install.
    chmod 700 "$DOTFILES_HOME/ssh/.ssh"
}

if is_omarchy
then
    ensure_local_dotfiles
    exec "$DOTFILES_HOME/omarchy/install" "$@"
fi

ensure_package_manager
ensure_dependencies
ensure_local_dotfiles
place_configuration
secure_ssh_permissions

exit 0
