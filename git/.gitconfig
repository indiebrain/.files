[diff]
    algorithm = patience

[core]
    commitGraph = true
    excludesfile = ~/.gitignore_global
    fsmonitor = true
    untrackedcache = true

[remote "origin"]
    prune = true
    tagopt = --no-tags

[color]
    ui = true

[alias]
    cb  = checkout -b
    co  = checkout
    db  = branch -d
    rclone = clone --recursive

[commit]
    gpgSign = true

[gc]
    writeCommitGraph = true

[clean]
    requireforce = false

[push]
    default = simple

[feature]
    manyFiles = true

[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process

[include]
    path = .gitconfig.local
