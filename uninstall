#! /usr/bin/env bash
# Author:
#   Aaron Kuehler
#
# Purpose:
#   Uninstall the dotfiles
#

set -euo pipefail

DOTFILES_HOME="$HOME/.files"
PLATFORM="$(uname)"

function remove_configuration() {
    pushd "$DOTFILES_HOME" || { echo "Failed to change working directory to '$DOTFILES_HOME'. Aborting"; exit 1; }
    stow --delete \
        asdf \
        bash \
        btop \
        emacs \
        firefox \
        ghostty \
        git \
        gnome-terminal \
        herdr \
        iterm2 \
        k9s \
        proselint \
        ripgrep \
        ruby \
        scripts \
        ssh

    # The ollama package is placed only on Darwin, so only remove it there.
    # Booting the agent out first leaves no service pointing at a dead link.
    if [ "$PLATFORM" == "Darwin" ]
    then
        launchctl bootout "gui/$(id -u)/com.aaron-kuehler.ollama" 2> /dev/null || true
        stow --delete ollama
    fi
    popd || return
}

remove_configuration


exit 0
